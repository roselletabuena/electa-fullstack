aws_region            = "ap-southeast-1"
environment           = "prod"
app_name              = "electa"
cognito_domain_prefix = "electa-auth-prod"

# Google OAuth 2.0 Credentials (obtain from Google Cloud Console for Production)
google_client_id     = "YOUR_PRODUCTION_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
google_client_secret = "YOUR_PRODUCTION_GOOGLE_CLIENT_SECRET"

callback_urls = [
  "https://electa.example.com/api/auth/callback/cognito"
]

logout_urls = [
  "https://electa.example.com/login"
]

# ──────────────────────────────────────────────────────────────────────────────
# Electa / Electa — Environment Variables Template
# ──────────────────────────────────────────────────────────────────────────────

# Database Configuration (PostgreSQL / Supabase)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# Supabase Client API (Optional for local development)
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Authentication Strategy (local | localstack | cognito)
AUTH_PROVIDER="cognito"
AUTH_SECRET="electa_local_jwt_secret_dev_32_bytes_long"

# ─── AWS Infrastructure Configuration (VS-41) ────────────────────────────────
# AWS Region for S3 and Cognito
AWS_REGION="ap-southeast-1"
NEXT_PUBLIC_AWS_REGION="ap-southeast-1"

# AWS S3 Media Bucket (Managed via electa-infra/modules/storage)
S3_MEDIA_BUCKET="electa-dev-media-assets"
NEXT_PUBLIC_S3_MEDIA_BUCKET="electa-dev-media-assets"

# AWS Cognito User Pool & Hosted UI Domain
NEXT_PUBLIC_COGNITO_USER_POOL_ID="ap-southeast-1_xxxxxxxxx"
NEXT_PUBLIC_COGNITO_CLIENT_ID="your-cognito-client-id"
COGNITO_DOMAIN="https://electa-auth-dev.auth.ap-southeast-1.amazoncognito.com"
NEXT_PUBLIC_COGNITO_DOMAIN="https://electa-auth-dev.auth.ap-southeast-1.amazoncognito.com"

# ─── Application & Security ──────────────────────────────────────────────────
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cloudflare Turnstile Bot Mitigation
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"

# PayMongo Payment Gateway
PAYMONGO_SECRET_KEY=""
PAYMONGO_PUBLIC_KEY=""
PAYMONGO_WEBHOOK_SECRET_KEY=""
NEXT_PUBLIC_PAYMONGO_PUBLIC_KEY=""

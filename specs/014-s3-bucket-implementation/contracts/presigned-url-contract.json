{
  "openapi": "3.1.0",
  "info": {
    "title": "Electa S3 Direct Upload API",
    "version": "1.0.0",
    "description": "Secure pre-signed URL generation for browser-to-S3 direct asset uploads."
  },
  "paths": {
    "/api/s3-bucket-implementation": {
      "post": {
        "summary": "Request Pre-signed S3 Upload URL",
        "operationId": "generatePresignedUploadUrl",
        "security": [
          { "CognitoSessionAuth": [] }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["filename", "contentType", "fileSizeBytes", "entityType", "entityId"],
                "properties": {
                  "filename": { "type": "string", "example": "hero-banner.webp" },
                  "contentType": {
                    "type": "string",
                    "enum": ["image/jpeg", "image/png", "image/webp", "image/avif"],
                    "example": "image/webp"
                  },
                  "fileSizeBytes": { "type": "integer", "example": 2048000 },
                  "entityType": {
                    "type": "string",
                    "enum": ["event_banner", "contestant_avatar", "category_badge", "sponsor_logo"],
                    "example": "event_banner"
                  },
                  "entityId": { "type": "string", "example": "evt_clx12345" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Pre-signed URL successfully generated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["success", "data"],
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "data": {
                      "type": "object",
                      "required": ["uploadUrl", "key", "publicUrl", "expiresInSeconds"],
                      "properties": {
                        "uploadUrl": { "type": "string", "format": "uri" },
                        "key": { "type": "string", "example": "events/evt_clx12345/banners/3f9b2d6a-4812-4c6e-9271-bf321b0e52fa.webp" },
                        "publicUrl": { "type": "string", "format": "uri", "example": "https://electa-assets.s3.ap-southeast-1.amazonaws.com/events/evt_clx12345/banners/3f9b2d6a-4812-4c6e-9271-bf321b0e52fa.webp" },
                        "expiresInSeconds": { "type": "integer", "example": 300 }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation error (invalid MIME type or payload exceeds size limit)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": false },
                    "error": { "type": "string", "example": "File exceeds the maximum allowable size for this asset type." }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized — valid session required",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": false },
                    "error": { "type": "string", "example": "Unauthorized" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
